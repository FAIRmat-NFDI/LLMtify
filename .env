# ---- LLM gateway (LiteLLM proxy, OpenAI-compatible) ----
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=sk-hackathon-master-key
# Upstream provider keys consumed by the LiteLLM proxy (docker-compose passes them through)
OPENAI_API_KEY=
AZURE_API_KEY=
AZURE_API_BASE=

# ---- Telemetry (Aspire dashboard: UI http://localhost:18888) ----
OTEL_SERVICE_NAME=hackframe
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENABLE_SENSITIVE_DATA=true

# ---- DevUI ----
DEVUI_PORT=8080
DEVUI_AUTO_OPEN=false
DEVUI_AUTH_ENABLED=false

# ---- Framework ----
HACKFRAME_CONFIG_DIR=config
HACKFRAME_SKILLS_DIR=skills
HACKFRAME_TEMP_DIR=temp

# ---- NOMAD (input by entry URL / id) ----
NOMAD_BASE_URL=https://nomad-lab.eu/prod/v1/api/v1

# ---- MOFid (Singularity image, see ./run.sh mofid) ----
MOFID_SIF=external/mofid.sif
# extra singularity flags; --userns is retried automatically inside containers
MOFID_SINGULARITY_FLAGS=
